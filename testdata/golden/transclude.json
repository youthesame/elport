{
  "extract": [
    {
      "name": "md_image_and_link",
      "input": "![plot](fig/a.png) and [data](raw.csv)\n",
      "refs": [
        {
          "path": "fig/a.png",
          "kind": "markdown",
          "char_start": 8,
          "char_end": 17,
          "byte_start": 8,
          "byte_end": 17,
          "slice": "fig/a.png"
        },
        {
          "path": "raw.csv",
          "kind": "markdown",
          "char_start": 30,
          "char_end": 37,
          "byte_start": 30,
          "byte_end": 37,
          "slice": "raw.csv"
        }
      ]
    },
    {
      "name": "md_angle_with_spaces",
      "input": "![plot](<my fig (1).png> \"Title (x)\")\n",
      "refs": [
        {
          "path": "my fig (1).png",
          "kind": "angle",
          "char_start": 8,
          "char_end": 24,
          "byte_start": 8,
          "byte_end": 24,
          "slice": "<my fig (1).png>"
        }
      ]
    },
    {
      "name": "md_balanced_parens",
      "input": "[file](dir/run(1)/out(2).csv)\n",
      "refs": [
        {
          "path": "dir/run(1)/out(2).csv",
          "kind": "markdown",
          "char_start": 7,
          "char_end": 28,
          "byte_start": 7,
          "byte_end": 28,
          "slice": "dir/run(1)/out(2).csv"
        }
      ]
    },
    {
      "name": "md_escaped_parens_and_space",
      "input": "[file](dir/a\\ b\\(1\\).csv)\n",
      "refs": [
        {
          "path": "dir/a\\ b(1).csv",
          "kind": "markdown",
          "char_start": 7,
          "char_end": 24,
          "byte_start": 7,
          "byte_end": 24,
          "slice": "dir/a\\ b\\(1\\).csv"
        }
      ]
    },
    {
      "name": "md_fragment_and_query",
      "input": "[sec](other.md#results) [q](a.csv?v=1)\n",
      "refs": [
        {
          "path": "other.md#results",
          "kind": "markdown",
          "char_start": 6,
          "char_end": 22,
          "byte_start": 6,
          "byte_end": 22,
          "slice": "other.md#results"
        },
        {
          "path": "a.csv?v=1",
          "kind": "markdown",
          "char_start": 28,
          "char_end": 37,
          "byte_start": 28,
          "byte_end": 37,
          "slice": "a.csv?v=1"
        }
      ]
    },
    {
      "name": "md_reference_def",
      "input": "[fig1]: plot.png \"Plot\"\n[fig2]: <sp ace.png>\n",
      "refs": []
    },
    {
      "name": "html_figure_and_tags",
      "input": "<figure><img src=\"fig.png\" width=\"80%\"><figcaption>図1</figcaption></figure>\n<a href='doc.pdf'>pdf</a> <source src=clip.mp4>\n",
      "refs": [
        {
