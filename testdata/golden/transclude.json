        "a/**/d.png"
      ],
      "prefix": "",
      "ignored": true
    },
    {
      "name": "fnmatch_negated_class",
      "relative": "b.csv",
      "patterns": [
        "[!a].csv"
      ],
      "prefix": "",
      "ignored": true
    },
    {
      "name": "fnmatch_negated_class_no_match",
      "relative": "a.csv",
      "patterns": [
        "[!a].csv"
      ],
      "prefix": "",
      "ignored": false
    },
    {
      "name": "negation_override",
      "relative": "keep.csv",
      "patterns": [
        "*.csv",
        "!keep.csv"
      ],
      "prefix": "",
      "ignored": true
    },
    {
      "name": "layer_prefix",
      "relative": "data.csv",
      "patterns": [
        "sub/*.csv"
      ],
      "prefix": "sub",
      "ignored": true
    }
